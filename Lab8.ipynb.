        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# Plot 1: Histogram (seaborn) - alcohol distribution\n",
        "plt.figure(figsize=(7, 5))\n",
        "sns.histplot(data=df_clean, x=\"alcohol\", bins=25, kde=True, color=\"#8B1A3A\")\n",
        "plt.title(\"Distribution of Alcohol Content\")\n",
        "plt.xlabel(\"Alcohol (%)\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.savefig(\"plot1_histogram.png\", dpi=150, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "# Plot 2: Scatter plot (matplotlib) - alcohol vs volatile acidity by quality level\n",
        "plt.figure(figsize=(7, 5))\n",
        "colors = {\"Low (3-5)\": \"red\", \"Medium (6)\": \"gold\", \"High (7-8)\": \"green\"}\n",
        "for level, color in colors.items():\n",
        "    sub = df_clean[df_clean[\"quality_level\"] == level]\n",
        "    plt.scatter(sub[\"alcohol\"], sub[\"volatile acidity\"], c=color, label=level, alpha=0.6)\n",
        "plt.title(\"Alcohol vs Volatile Acidity by Quality Level\")\n",
        "plt.xlabel(\"Alcohol (%)\")\n",
        "plt.ylabel(\"Volatile Acidity\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.savefig(\"plot2_scatter.png\", dpi=150, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "# Plot 3: Box plot (seaborn) - alcohol by quality level\n",
        "plt.figure(figsize=(7, 5))\n",
        "sns.boxplot(data=df_clean, x=\"quality_level\", y=\"alcohol\",\n",
